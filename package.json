{
  "name": "etijah-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3101",
    "build": "next build",
    "start": "next start --port 3101",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:init": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db.mjs init",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db.mjs check",
    "db:seed-geo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db.mjs seed-geo",
    "staff:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db.mjs list-staff",
    "staff:create": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db.mjs create-staff",
    "staff:reset-password": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/db.mjs reset-password",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/e2e-travel.mjs",
    "images": "node scripts/optimize-images.mjs",
    "globe": "node --no-warnings scripts/build-globe.mjs",
    "icons": "node scripts/build-icons.mjs",
    "partners": "node scripts/build-partners.mjs",
    "assets": "npm run images && npm run globe && npm run icons && npm run partners",
    "og": "node scripts/build-og.mjs",
    "test:tours": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/test-tours-destinations.mjs",
    "test:rooms": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/test-room-types.mjs",
    "test:geo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/test-geo.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "mongodb": "^7.8.0",
    "next": "16.4.6",
    "playwright-core": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
