# Environment variables — set them in Vercel → Project → Settings → Environment Variables
# (Production and Preview). To run CLI commands or `npm run dev` on your machine against the same
# cloud services:  vercel link  →  vercel env pull .env.local
# Never commit real values: .env* files are git-ignored (except this template).

# ---------------------------------------------------------------- Site
# Public production URL, without a trailing slash (e.g. https://www.etijah.example).
# Canonical URLs, hreflang, Open Graph images, the sitemap and the "online version" link in quote
# PDFs. If empty, Vercel's production domain (<project>.vercel.app) is used automatically.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- Database (MongoDB Atlas) — required
# Atlas → Database → Connect → Drivers. Atlas → Network Access must allow 0.0.0.0/0
# (Vercel functions have no fixed IP addresses).
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=etijah
# Optional: connection pool size per function instance (default 10).
MONGODB_POOL_SIZE=

# ---------------------------------------------------------------- Uploaded images (Vercel Blob) — required
# Vercel → Storage → Create → Blob, then "Connect Project": BLOB_READ_WRITE_TOKEN is added for you.
BLOB_READ_WRITE_TOKEN=
# Must match the access chosen when the store was created: private (default) or public.
BLOB_ACCESS=private

# ---------------------------------------------------------------- Security
# Secret for signed links and IP hashing (32+ random characters), e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If empty, one is generated and stored in the database on first use.
APP_SECRET=
