# Public production URL, without a trailing slash (e.g. https://www.example.com).
# Enables canonical URLs, hreflang alternates, Open Graph images and sitemap entries,
# and is used for the "online version" link printed in quote PDFs.
# For a sub-folder deployment, include the folder (e.g. https://www.example.com/etijah).
NEXT_PUBLIC_SITE_URL=

# Optional: serve the site from a sub-folder instead of the domain root (e.g. /etijah).
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------- Data & storage
# SQLite database file (created and migrated automatically). Default: data/etijah.db
DATABASE_PATH=
# Uploaded images (re-encoded WebP). Default: storage/media
MEDIA_DIR=
# Generated quote PDFs (cache, safe to delete). Default: storage/pdf-cache
PDF_CACHE_DIR=

# ---------------------------------------------------------------- Security
# Secret for signed links and IP hashing (32+ random characters). If empty, one is generated
# and stored in the database on first use. Set it explicitly when running several instances.
APP_SECRET=
# Force the Secure flag on the staff session cookie (it is set automatically behind HTTPS).
SESSION_COOKIE_SECURE=
# Stable key for Server Action encryption when running several instances (see Next.js docs).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---------------------------------------------------------------- PDF generation
# Quote PDFs are rendered by an installed Chromium browser. Defaults: Edge on Windows, Chrome elsewhere.
PDF_BROWSER_CHANNEL=
# Or an explicit browser executable, e.g. /usr/bin/chromium
PDF_BROWSER_PATH=
# Origin the renderer uses to load the print page (default: the request's own origin),
# e.g. http://127.0.0.1:3101 behind a reverse proxy.
PDF_RENDER_ORIGIN=
