# Public production URL, without a trailing slash (e.g. https://www.example.com).
# Enables canonical URLs, hreflang alternates, Open Graph images and sitemap entries.
# For a sub-folder deployment, include the folder (e.g. https://www.example.com/etijah).
NEXT_PUBLIC_SITE_URL=

# Optional: serve the site from a sub-folder instead of the domain root (e.g. /etijah).
NEXT_PUBLIC_BASE_PATH=
